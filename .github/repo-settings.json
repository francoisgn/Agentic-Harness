{
  "$comment": "Repository settings of the harness, applied on merge by .github/workflows/settings.yml (scripts/repo-settings.py). Change them by PR, never by hand in Settings (drift is reported every week).",
  "repository": {
    "description": "Versioned harness to steer agentic development (Claude Code): intent and TDD, issues → lots → PRs, adversarial reviews, pluggable compliance, stewards, FinOps and flow dashboard.",
    "has_wiki": false,
    "delete_branch_on_merge": true
  },
  "topics": ["agentic", "claude-code", "ai-agents", "devops", "code-review", "compliance", "finops", "tdd", "github-actions", "framework"],
  "rulesets": [
    {
      "name": "protected master",
      "target": "branch",
      "enforcement": "active",
      "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
      "bypass_actors": [],
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "required_status_checks": [{ "context": "Scripts, workflows, tests" }]
          }
        }
      ]
    }
  ]
}
