# Files that scripts/harness-sync.sh vendors into a consumer repository.
# One line per entry: MODE SOURCE DESTINATION [ID [TEMPLATE]]   (SOURCE relative to the harness, DESTINATION to the consumer)
#
#   copy       file owned by the harness: replaced at every sync; refused if it was modified locally
#              (digest different from the one in the .harness/lock lock), unless --force. Deleted if the entry
#              disappears from the manifest and the file was not modified.
#   tree       like copy, for every file of a directory (recursive).
#   block      managed block between <!-- harness:begin ID --> and <!-- harness:end ID -->; the rest of the file is
#              never touched. Missing file: created from TEMPLATE (which contains the markers). Missing markers: block
#              appended at the end of the file. {{HARNESS_VERSION}} is replaced by the version.
#   seed       created only if it does not exist (a project file from then on, never rewritten).
#   jsonmerge  JSON merge: adds the missing keys and list items, never changes an existing value.
#   refbump    rewrites the references `<harness repository>/.github/workflows/<file>@<ref>` to the synced commit
#              (`@<sha> # vX.Y.Z`, pinning required by zizmor; `@vX.Y.Z` if the commit is unknown or modified).
# Destinations under .github/workflows/ are skipped with --skip-workflows (the GITHUB_TOKEN cannot push them).

# Rules and method (read by the agent, imported by CLAUDE.md for ESSENTIALS.md)
tree      docs                                        .harness/docs
copy      templates/.github/labels.json               .harness/labels.json

# Licence of the harness (MIT): it travels with the copied files, the project has nothing to do to comply with it
copy      LICENSE                                     .harness/LICENSE

# Skills: copied into the repository so they also work in a cloud session (which does not load the repository's plugins)
tree      plugins/harness/skills                      .claude/skills

# Subagents (adversarial reviewer, stewards, compliance): .claude/agents/ works in the cloud as it does locally
tree      plugins/harness/agents                      .claude/agents

# Flow dashboard script (called by flow-report.yml and /status-report)
copy      scripts/flow-metrics.py                     .harness/scripts/flow-metrics.py
copy      scripts/compliance-plan.py                  .harness/scripts/compliance-plan.py
copy      scripts/repo-settings.py                    .harness/scripts/repo-settings.py

# Project README: standard check, progress table generated from the issues and rendering of the Excalidraw diagrams (README-STANDARD.md)
copy      scripts/readme-check.py                     .harness/scripts/readme-check.py
copy      scripts/readme-progress.py                  .harness/scripts/readme-progress.py
copy      scripts/diagrams/render.py                  .harness/scripts/diagrams-render.py
# Relative links and cross-file anchors in Markdown (docs-security.yml; in-file anchors are markdownlint's MD051)
copy      scripts/doc-links.py                        .harness/scripts/doc-links.py
# Doc steward: "anything to fold?" decision, docs PR body, weekly audit issues (doc-steward.yml, STEWARDS.md §2)
copy      scripts/doc-steward.py                      .harness/scripts/doc-steward.py
# Operator decisions file: at most one decision in force per scope key (docs-security.yml; off when docs/DECISIONS.md is absent)
copy      scripts/decisions-check.py                  .harness/scripts/decisions-check.py

# Vendored hooks (git guardrail, session reminder) and their declaration
copy      plugins/harness/scripts/guard-git.py        .harness/hooks/guard-git.py
copy      plugins/harness/scripts/session-start.sh    .harness/hooks/session-start.sh
jsonmerge templates/.claude/settings.harness.json     .claude/settings.json

# Agent instructions: only the "harness" block belongs to the harness
block     templates/CLAUDE.md.block                   CLAUDE.md   harness templates/CLAUDE.md.template
block     templates/AGENTS.md.block                   AGENTS.md   harness templates/AGENTS.md.template

# Project templates (created once, then the project's own)
seed      templates/.harness/config.json              .harness/config.json
seed      templates/.github/labels.local.json         .github/labels.local.json
seed      templates/.github/repo-settings.json        .github/repo-settings.json
seed      templates/.github/pull_request_template.md  .github/pull_request_template.md
seed      templates/.github/ISSUE_TEMPLATE/config.yml   .github/ISSUE_TEMPLATE/config.yml
seed      templates/.github/ISSUE_TEMPLATE/feedback.yml .github/ISSUE_TEMPLATE/feedback.yml
seed      templates/.github/ISSUE_TEMPLATE/bug.yml      .github/ISSUE_TEMPLATE/bug.yml
seed      templates/.github/ISSUE_TEMPLATE/feature.yml  .github/ISSUE_TEMPLATE/feature.yml
seed      templates/.github/ISSUE_TEMPLATE/task.yml     .github/ISSUE_TEMPLATE/task.yml
seed      templates/docs/lots/TEMPLATE.md             docs/lots/TEMPLATE.md
seed      templates/docs/compliance/TEMPLATE.md       docs/compliance/TEMPLATE.md
seed      templates/docs/DECISIONS.md                 docs/DECISIONS.md
seed      templates/.markdownlint-cli2.jsonc          .markdownlint-cli2.jsonc
# Local check = the CI (CI-BASELINE.md §3): a skeleton that says INCOMPLETE until /local-check fills in its steps
seed      templates/scripts/local-check.sh            scripts/local-check.sh
# README at the harness standard: never rewritten if it already exists (readme-check.py then lists the gaps)
seed      templates/README.md.template                README.md
seed      templates/CONTRIBUTING.md.template          CONTRIBUTING.md
seed      templates/docs/diagrams/architecture.json        docs/diagrams/architecture.json
seed      templates/docs/diagrams/architecture.svg         docs/diagrams/architecture.svg
seed      templates/docs/diagrams/architecture.excalidraw  docs/diagrams/architecture.excalidraw
seed      templates/.github/workflows/harness.yml       .github/workflows/harness.yml
seed      templates/.github/workflows/harness-sync.yml  .github/workflows/harness-sync.yml
refbump   -                                           .github/workflows/harness.yml
