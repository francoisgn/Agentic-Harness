# Fichiers que scripts/harness-sync.sh vendorise dans un dépôt consommateur.
# Une ligne par entrée : MODE SOURCE DESTINATION [ID [GABARIT]]   (SOURCE relative au cadre, DESTINATION au consommateur)
#
#   copy       fichier possédé par le cadre : remplacé à chaque synchro ; refusé s'il a été modifié localement
#              (empreinte différente de celle du verrou .harness/lock), sauf --force. Supprimé si l'entrée disparaît
#              du manifeste et que le fichier n'a pas été modifié.
#   tree       comme copy, pour chaque fichier d'un dossier (récursif).
#   block      bloc géré entre <!-- harness:begin ID --> et <!-- harness:end ID --> ; le reste du fichier n'est jamais
#              touché. Fichier absent : créé depuis GABARIT (qui contient les marqueurs). Marqueurs absents : bloc ajouté
#              en fin de fichier. {{HARNESS_VERSION}} est remplacé par la version.
#   seed       créé seulement s'il n'existe pas (fichier du projet ensuite, jamais réécrit).
#   jsonmerge  fusion JSON : ajoute les clés et éléments de liste absents, ne modifie jamais une valeur existante.
#   refbump    réécrit les références `<dépôt du cadre>/.github/workflows/<fichier>@<ref>` vers le commit synchronisé
#              (`@<sha> # vX.Y.Z`, épinglage exigé par zizmor ; `@vX.Y.Z` si le commit est inconnu ou modifié).
# Les destinations sous .github/workflows/ sont sautées avec --skip-workflows (le GITHUB_TOKEN ne peut pas les pousser).

# Règles et méthode (lues par l'agent, importées par CLAUDE.md pour ESSENTIEL.md)
tree      docs                                        .harness/docs
copy      templates/.github/labels.json               .harness/labels.json

# Licence du cadre (MIT) : elle accompagne les fichiers copiés, le projet n'a rien à faire pour la respecter
copy      LICENSE                                     .harness/LICENSE

# Skills : copiés dans le dépôt pour fonctionner aussi en session cloud (qui ne charge pas les plugins du dépôt)
tree      plugins/harness/skills                      .claude/skills

# Sous-agents (relecteur adversarial, stewards, conformité) : .claude/agents/ fonctionne en cloud comme en local
tree      plugins/harness/agents                      .claude/agents

# Script du tableau de bord du flux (appelé par flow-report.yml et /status-report)
copy      scripts/flow-metrics.py                     .harness/scripts/flow-metrics.py
copy      scripts/compliance-plan.py                  .harness/scripts/compliance-plan.py
copy      scripts/repo-settings.py                    .harness/scripts/repo-settings.py

# Hooks vendorisés (garde-fou git, rappel de session) et leur déclaration
copy      plugins/harness/scripts/guard-git.py        .harness/hooks/guard-git.py
copy      plugins/harness/scripts/session-start.sh    .harness/hooks/session-start.sh
jsonmerge templates/.claude/settings.harness.json     .claude/settings.json

# Instructions d'agent : seul le bloc « cadre » appartient au cadre
block     templates/CLAUDE.md.block                   CLAUDE.md   cadre   templates/CLAUDE.md.template
block     templates/AGENTS.md.block                   AGENTS.md   cadre   templates/AGENTS.md.template

# Gabarits du projet (créés une fois, puis à lui)
seed      templates/.harness/config.json              .harness/config.json
seed      templates/.github/labels.local.json         .github/labels.local.json
seed      templates/.github/repo-settings.json        .github/repo-settings.json
seed      templates/.github/pull_request_template.md  .github/pull_request_template.md
seed      templates/.github/ISSUE_TEMPLATE/config.yml   .github/ISSUE_TEMPLATE/config.yml
seed      templates/.github/ISSUE_TEMPLATE/feedback.yml .github/ISSUE_TEMPLATE/feedback.yml
seed      templates/.github/ISSUE_TEMPLATE/bug.yml      .github/ISSUE_TEMPLATE/bug.yml
seed      templates/.github/ISSUE_TEMPLATE/feature.yml  .github/ISSUE_TEMPLATE/feature.yml
seed      templates/.github/ISSUE_TEMPLATE/tache.yml    .github/ISSUE_TEMPLATE/tache.yml
seed      templates/docs/lots/TEMPLATE.md             docs/lots/TEMPLATE.md
seed      templates/docs/compliance/TEMPLATE.md       docs/compliance/TEMPLATE.md
seed      templates/.markdownlint-cli2.jsonc          .markdownlint-cli2.jsonc
seed      templates/.github/workflows/harness.yml       .github/workflows/harness.yml
seed      templates/.github/workflows/harness-sync.yml  .github/workflows/harness-sync.yml
refbump   -                                           .github/workflows/harness.yml
